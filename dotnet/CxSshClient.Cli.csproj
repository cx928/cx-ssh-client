<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CxSshClient.Cli</RootNamespace>
    <AssemblyName>cx-ssh</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <Product>程星SSH客户端 CLI</Product>
    <Company>程星工作室</Company>
    <Description>cx-ssh-client 命令行客户端 (SSH/SFTP/FTP/RDP + 加密密码库 + 账号同步)</Description>
    <Version>1.0.0</Version>
    <Copyright>MPL-2.0</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2024.0.0" />
    <PackageReference Include="FluentFTP" Version="50.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
