<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CxSshClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CxSshClient"
    xmlns:models="using:CxSshClient.Models"
    xmlns:helpers="using:CxSshClient.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Grid Grid.Row="0" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="26" Height="26" VerticalAlignment="Center"/>
                <TextBlock Text="cx-ssh-client" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="程星SSH客户端" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <Border x:Name="DragRegion" Grid.Column="1" Background="Transparent"/>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="302"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 协议导航栏 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="NavList"
                              SelectionMode="Single"
                              Padding="5,8,5,0"
                              Background="Transparent"
                              ItemContainerStyle="{StaticResource NavRailItem}"
                              SelectionChanged="NavList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavItem">
                                <StackPanel Spacing="3" HorizontalAlignment="Center" Padding="0,4"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="17"
                                              Foreground="{x:Bind Foreground, Mode=OneWay}"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Title}" FontSize="9" HorizontalAlignment="Center"
                                               Foreground="{x:Bind Foreground, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Spacing="4" Margin="5,0,5,12" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Click="SyncNow_Click"
                                ToolTipService.ToolTip="立即同步账号">
                            <Grid>
                                <FontIcon Glyph="&#xE895;" FontSize="16"/>
                                <Ellipse x:Name="SyncDot" Width="7" Height="7" Fill="#2EA96F"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="OpenSettings_Click"
                                ToolTipService.ToolTip="设置">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中: 会话列表 -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Padding="14,14,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ListHeaderText" Text="全部会话" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ListSubText" Text="0 个连接" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="0,0,4,0"
                                Click="Import_Click" ToolTipService.ToolTip="导入密码文件">
                            <FontIcon Glyph="&#xE898;" FontSize="15"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                Click="NewSession_Click" ToolTipService.ToolTip="新建会话">
                            <FontIcon Glyph="&#xE710;" FontSize="15"/>
                        </Button>
                    </Grid>

                    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10"
                             PlaceholderText="搜索 名称 / 主机 / 用户名"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>

                    <ListView x:Name="SessionsList" Grid.Row="2"
                              SelectionMode="Single"
                              Background="Transparent"
                              Padding="0"
                              ItemContainerStyle="{StaticResource SessionItemStyle}"
                              DoubleTapped="SessionsList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionInfo">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <Border Width="3" Height="34" CornerRadius="2"
                                                Background="{x:Bind ProtocolBrush}"/>
                                        <Border Width="36" Height="36" CornerRadius="9"
                                                Background="{x:Bind ProtocolSoftBrush}">
                                            <FontIcon Glyph="{x:Bind ProtocolGlyph}"
                                                      FontSize="15"
                                                      Foreground="{x:Bind ProtocolBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SubTitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ProtocolLabel}" FontSize="9.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{x:Bind ProtocolBrush}"/>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                                Click="CardConnect_Click" Tag="{x:Bind}"
                                                ToolTipService.ToolTip="连接">
                                            <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="连接" Click="CardConnect_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="编辑" Click="CardEdit_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="复制副本" Click="CardDuplicate_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="删除" Click="CardDelete_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyHint" Grid.Row="2" Margin="10,26,10,0" Spacing="8"
                                VerticalAlignment="Top" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE710;" FontSize="22" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="还没有会话" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="点击右上角 + 新建连接，或用「导入密码文件」批量导入"
                                   FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="VaultCountText" Text="库: 0" FontSize="10.5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="VaultSyncText" Text="未同步" FontSize="10.5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右: 标签页 + 内容 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,7" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="TabsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:OpenTab">
                                    <Border Background="{x:Bind HeaderBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind HeaderBorderBrush, Mode=OneWay}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="9,5,5,5"
                                            Tapped="TabChip_Tapped">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Border Width="7" Height="7" CornerRadius="4"
                                                    Background="{x:Bind AccentBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12"
                                                       VerticalAlignment="Center" MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Style="{StaticResource TabCloseStyle}"
                                                    Click="TabClose_Click" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE711;" FontSize="9"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1">
                    <!-- 空状态 -->
                    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="14" MaxWidth="460">
                        <Image x:Name="WelcomeIcon" Width="112" Height="112" HorizontalAlignment="Center"/>
                        <TextBlock Text="程星SSH客户端" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="一个客户端管理 SSH · SFTP · FTP · RDP · VNC"
                                   FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="NewSession_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="新建连接"/></StackPanel>
                            </Button>
                            <Button Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" FontSize="14"/><TextBlock Text="导入密码文件"/></StackPanel>
                            </Button>
                            <Button Click="SyncNow_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="14"/><TextBlock Text="账号同步"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="13"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="WelcomeSyncText" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="账号同步: 未配置"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 会话内容宿主 (所有内容常驻视觉树, 仅切换可见性) -->
                    <Grid x:Name="ContentHost"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#2EA96F"/>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="TabCountText" Text="0 个会话打开" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="v1.0.0" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
