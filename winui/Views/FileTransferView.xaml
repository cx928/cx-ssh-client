<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CxSshClient.Views.FileTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CxSshClient.Models">

    <UserControl.Resources>
        <Style x:Key="FTButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Border Grid.Row="0" Padding="14,9" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#E8912D" VerticalAlignment="Center"/>
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Text="尚未连接"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource FTButton}" Click="Refresh_Click" ToolTipService.ToolTip="刷新两侧目录">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource FTButton}" Click="Reconnect_Click" ToolTipService.ToolTip="重新连接">
                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource FTButton}" Click="Disconnect_Click" ToolTipService.ToolTip="断开并关闭">
                        <FontIcon Glyph="&#xE8BB;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 双栏文件浏览 -->
        <Grid Grid.Row="1" Padding="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 本地 -->
            <Border Grid.Column="0" BorderThickness="1" CornerRadius="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F8;" FontSize="12" Foreground="#2E7BD6"/>
                            <TextBlock Text="本地" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FTButton}" Click="LocalUp_Click" ToolTipService.ToolTip="上一级">
                            <FontIcon Glyph="&#xE74A;" FontSize="13"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource FTButton}" Click="LocalRefresh_Click" ToolTipService.ToolTip="刷新本地">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                    </Grid>
                    <TextBox x:Name="LocalPathBox" Grid.Row="1" Margin="8,0,8,8" FontSize="11.5"
                             KeyDown="LocalPath_KeyDown" PlaceholderText="本地路径"/>
                    <ListView x:Name="LocalList" Grid.Row="2" SelectionMode="Extended" Background="Transparent"
                              Padding="6,0,6,6" DoubleTapped="LocalList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Grid Padding="2,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 中间: 传输按钮 -->
            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Margin="10,0">
                <Button x:Name="UploadButton" Width="46" Height="38" CornerRadius="10"
                        Click="Upload_Click" ToolTipService.ToolTip="上传选中的本地文件到远程目录"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon Glyph="&#xE898;" FontSize="14"/>
                </Button>
                <Button x:Name="DownloadButton" Width="46" Height="38" CornerRadius="10"
                        Click="Download_Click" ToolTipService.ToolTip="下载选中的远程文件到本地目录">
                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                </Button>
            </StackPanel>

            <!-- 远程 -->
            <Border Grid.Column="2" BorderThickness="1" CornerRadius="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="RemoteProtoIcon" Glyph="&#xE8B7;" FontSize="12" Foreground="#8B5CF6"/>
                            <TextBlock x:Name="RemoteTitleText" Text="远程" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FTButton}" Click="RemoteMkdir_Click" ToolTipService.ToolTip="新建文件夹">
                            <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource FTButton}" Click="RemoteDelete_Click" ToolTipService.ToolTip="删除选中项">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource FTButton}" Click="RemoteRefresh_Click" ToolTipService.ToolTip="刷新远程">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                    </Grid>
                    <TextBox x:Name="RemotePathBox" Grid.Row="1" Margin="8,0,8,8" FontSize="11.5"
                             KeyDown="RemotePath_KeyDown" PlaceholderText="远程路径"/>
                    <ListView x:Name="RemoteList" Grid.Row="2" SelectionMode="Extended" Background="Transparent"
                              Padding="6,0,6,6" DoubleTapped="RemoteList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Grid Padding="2,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Padding="10,6" Spacing="6">
                        <Button x:Name="RemoteUpButton" Style="{StaticResource FTButton}" Click="RemoteUp_Click"
                                ToolTipService.ToolTip="上一级目录">
                            <FontIcon Glyph="&#xE74A;" FontSize="13"/>
                        </Button>
                        <TextBlock x:Name="RemoteHintText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="双击进入文件夹"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 传输队列 -->
        <Border Grid.Row="2" Margin="12,0,12,10" BorderThickness="1" CornerRadius="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="Collapsed" x:Name="TransferPanel" MaxHeight="168">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="传输队列" FontSize="12" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="清除已完成" FontSize="11" Click="ClearTransfers_Click"
                            Background="Transparent" BorderThickness="0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" Padding="12,0,12,10">
                    <ItemsControl x:Name="TransferList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TransferItem">
                                <Grid Margin="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Value="{Binding Progress}"
                                                 Maximum="100" VerticalAlignment="Center" Height="6"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11"
                                               VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部状态 -->
        <Border Grid.Row="3" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="BottomStatus" FontSize="11" Text="就绪"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
