<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CxSshClient.Views.SessionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CxSshClient.Views"
    Title="新建会话"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="460" Spacing="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Header="名称" PlaceholderText="例如: 生产服务器"/>
                <ComboBox x:Name="ProtocolBox" Grid.Column="1" Header="协议" Width="130" Margin="10,0,0,0"
                          SelectionChanged="ProtocolBox_SelectionChanged">
                    <ComboBoxItem Content="SSH 终端" Tag="ssh"/>
                    <ComboBoxItem Content="SFTP 文件" Tag="sftp"/>
                    <ComboBoxItem Content="FTP 文件" Tag="ftp"/>
                    <ComboBoxItem Content="RDP 桌面" Tag="rdp"/>
                    <ComboBoxItem Content="VNC 桌面" Tag="vnc"/>
                </ComboBox>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HostBox" Header="主机 / IP" PlaceholderText="192.168.1.10 或 example.com"/>
                <TextBox x:Name="PortBox" Grid.Column="1" Header="端口" Margin="10,0,0,0" Text="22"/>
            </Grid>

            <TextBox x:Name="UserBox" Header="用户名" PlaceholderText="root"/>

            <StackPanel Spacing="4">
                <PasswordBox x:Name="PassBox" Header="密码" PlaceholderText="登录密码或私钥口令"/>
                <CheckBox x:Name="ShowPassCheck" Content="显示密码" FontSize="12" Checked="ShowPass_Changed" Unchecked="ShowPass_Changed"/>
            </StackPanel>

            <StackPanel x:Name="KeyPanel" Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeyBox" Header="私钥文件 (可选)" PlaceholderText="C:\Users\me\.ssh\id_rsa"/>
                    <Button Grid.Column="1" Content="浏览…" Margin="10,26,0,0" Click="BrowseKey_Click"/>
                </Grid>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GroupBox" Header="分组 / 标签" PlaceholderText="生产环境"/>
                <TextBox x:Name="NoteBox" Grid.Column="1" Header="备注" Margin="10,0,0,0"/>
            </Grid>

            <!-- 桌面协议专属 -->
            <StackPanel x:Name="DesktopPanel" Spacing="10" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="DesktopTitle" Text="桌面会话选项" FontSize="13" FontWeight="SemiBold"/>
                        <ToggleSwitch x:Name="FullscreenSwitch" Header="全屏启动 (RDP)" IsOn="True"/>
                        <ToggleSwitch x:Name="AdminSwitch" Header="以管理员会话连接 (RDP)"/>
                        <ComboBox x:Name="ResolutionBox" Header="窗口分辨率 (非全屏时)" SelectedIndex="1" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="1280 × 720"/>
                            <ComboBoxItem Content="1600 × 900"/>
                            <ComboBoxItem Content="1920 × 1080"/>
                            <ComboBoxItem Content="2560 × 1440"/>
                        </ComboBox>
                        <ToggleSwitch x:Name="ReadOnlySwitch" Header="只读模式 (VNC，不发送键鼠)" Visibility="Collapsed"/>
                        <ToggleSwitch x:Name="ClipboardSwitch" Header="启用剪贴板同步 (VNC)" IsOn="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FTP 专属 -->
            <StackPanel x:Name="FtpPanel" Spacing="10" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FTP 选项" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox x:Name="FtpEncryptionBox" Header="加密方式" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="不加密 (FTP)"/>
                            <ComboBoxItem Content="显式 FTPS (AUTH TLS)"/>
                            <ComboBoxItem Content="隐式 FTPS"/>
                        </ComboBox>
                        <ComboBox x:Name="FtpModeBox" Header="数据连接模式" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="被动模式 (推荐)"/>
                            <ComboBoxItem Content="主动模式"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
