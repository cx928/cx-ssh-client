<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CxSshClient.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,9" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE713;" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Spacing="0">
                        <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="账号同步 · 密码导入导出 · 外观" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        CornerRadius="6" Padding="8,4" ToolTipService.ToolTip="关闭设置">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,20">
            <StackPanel Spacing="18" MaxWidth="880" HorizontalAlignment="Left">

                <!-- ============ 账号同步 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="#5B8DEF"/>
                            <TextBlock Text="账号同步" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="会话与密码在本机加密后上传到自建同步服务器；服务器只保存密文，无法解密你的密码。默认服务器：https://156.239.3.215:8443"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerBox" Header="服务器地址" PlaceholderText="https://156.239.3.215:8443"/>
                            <TextBox x:Name="UserBox" Grid.Column="1" Header="同步账号" PlaceholderText="admin"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PassBox" Header="同步密码" PlaceholderText="部署时生成的密码"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <ToggleSwitch x:Name="TrustSwitch" Header="信任自签名证书" IsOn="True"
                                              OnContent="是" OffContent="否"/>
                            </StackPanel>
                        </Grid>

                        <ComboBox x:Name="AutoSyncBox" Header="自动同步间隔" MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="关闭自动同步"/>
                            <ComboBoxItem Content="每 1 分钟"/>
                            <ComboBoxItem Content="每 5 分钟"/>
                            <ComboBoxItem Content="每 15 分钟"/>
                            <ComboBoxItem Content="每 30 分钟"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="SaveTest_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE95F;" FontSize="14"/><TextBlock Text="保存并测试连接"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="SyncNow_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="14"/><TextBlock Text="立即同步"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <InfoBar x:Name="SyncInfo" IsOpen="False" IsClosable="True"/>
                    </StackPanel>
                </Border>

                <!-- ============ 密码导入导出 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="#8B5CF6"/>
                            <TextBlock Text="密码导入 / 导出" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="加密备份使用 AES-256-GCM + PBKDF2(12 万次迭代) 保护，可安全地在设备间迁移；CSV 为明文表格，请谨慎保存。"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="ExportEncrypted_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14"/><TextBlock Text="导出加密备份"/></StackPanel>
                            </Button>
                            <Button Click="ExportCsv_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14"/><TextBlock Text="导出 CSV (明文)"/></StackPanel>
                            </Button>
                            <Button Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" FontSize="14"/><TextBlock Text="导入密码文件"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="OpenDataDir_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14"/><TextBlock Text="打开数据目录"/></StackPanel>
                            </Button>
                            <Button Click="ClearAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="清空全部会话"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="数据目录（密码库 / 设置 / 日志的存放位置）" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="DataDirText" FontSize="11.5" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                        <InfoBar x:Name="DataInfo" IsOpen="False" IsClosable="True"/>
                    </StackPanel>
                </Border>

                <!-- ============ 外观 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="#E8912D"/>
                            <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <RadioButtons x:Name="ThemeButtons" Header="主题" SelectedIndex="0"
                                      SelectionChanged="Theme_Changed">
                            <RadioButton Content="跟随系统"/>
                            <RadioButton Content="浅色"/>
                            <RadioButton Content="深色"/>
                        </RadioButtons>
                        <NumberBox x:Name="FontSizeBox" Header="终端字号" Value="14" Minimum="9" Maximum="28"
                                   SpinButtonPlacementMode="Compact" Width="200" HorizontalAlignment="Left"
                                   ValueChanged="FontSize_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ============ 关于 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="#2EA96F"/>
                            <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="程星SSH客户端 v1.0.0" FontSize="12.5"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="WinUI 3 (.NET 8) · SSH.NET · FluentFTP · 自研 RFB/VNC 引擎 · 自建 RemoteHub 同步服务端 (Python 标准库, systemd)"/>
                        <TextBlock x:Name="SyncStatusText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
