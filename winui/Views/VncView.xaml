<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CxSshClient.Views.VncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    KeyUp="OnKeyUp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,9" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#E8912D" VerticalAlignment="Center"/>
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Text="准备连接…"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="ZoomBox" SelectedIndex="0" MinWidth="104" FontSize="12"
                              SelectionChanged="Zoom_Changed">
                        <ComboBoxItem Content="适应窗口"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="50%"/>
                    </ComboBox>
                    <Button Click="SendCad_Click" ToolTipService.ToolTip="发送 Ctrl+Alt+Del" FontSize="12"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="12"/>
                            <TextBlock Text="Ctrl+Alt+Del" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SendClipboard_Click" ToolTipService.ToolTip="把本机剪贴板发送到远程"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="8,4">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                    </Button>
                    <Button Click="Reconnect_Click" ToolTipService.ToolTip="重新连接" FontSize="12"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="8,4">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    </Button>
                    <Button Click="Disconnect_Click" ToolTipService.ToolTip="断开并关闭"
                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="8,4">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0F0F17">
            <ScrollViewer x:Name="ScreenScroll" ZoomMode="Disabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
                <Grid x:Name="ScreenHost" Background="#0F0F17"
                      PointerPressed="Screen_PointerPressed"
                      PointerReleased="Screen_PointerReleased"
                      PointerMoved="Screen_PointerMoved"
                      PointerWheelChanged="Screen_PointerWheelChanged">
                    <Image x:Name="ScreenImage" Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="Overlay" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <ProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Name="OverlayText" Text="正在连接 VNC 服务…" FontSize="12.5" Foreground="#BAC2DE"/>
            </StackPanel>

            <InfoBar x:Name="Toast" IsOpen="False" IsClosable="True" Severity="Informational"
                     VerticalAlignment="Bottom" Margin="16,0,16,16"/>
        </Grid>
    </Grid>
</UserControl>
