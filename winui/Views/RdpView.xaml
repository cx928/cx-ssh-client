<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CxSshClient.Views.RdpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28,24" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="6">
                <TextBlock Text="远程桌面连接" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="使用 Windows 原生 mstsc 建立 RDP 连接；登录凭据会写入凭据管理器，退出后自动清除。"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="12" Background="#2E7BD6" Opacity="0.9">
                            <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AddressText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <ToggleSwitch x:Name="FullscreenSwitch" Header="全屏启动" IsOn="True" OnContent="是" OffContent="否"/>
                    <ToggleSwitch x:Name="AdminSwitch" Header="以管理员会话连接 (console)" OnContent="是" OffContent="否"/>

                    <ComboBox x:Name="ResolutionBox" Header="窗口分辨率 (非全屏时生效)" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="1280 × 720"/>
                        <ComboBoxItem Content="1600 × 900"/>
                        <ComboBoxItem Content="1920 × 1080"/>
                        <ComboBoxItem Content="2560 × 1440"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource AccentButtonStyle}"
                                Click="Launch_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="启动远程桌面"/></StackPanel>
                        </Button>
                        <Button Click="Save_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14"/><TextBlock Text="保存为默认设置"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" Severity="Informational"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="使用提示" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="• 远程主机需开启「远程桌面」并允许当前账号登录。&#x0a;• 若为非标准端口，会以 主机:端口 形式连接。&#x0a;• 首次连接可能需要在弹出的窗口中选择证书信任。&#x0a;• 如需更改为嵌入窗口显示，可安装 FreeRDP 客户端后在设置中切换（后续版本支持）。"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
